# The console's connection: a login role that is a member of outcomes_app (never the owner).
DATABASE_URL=postgres://outcomes_web:...@host:5432/postgres
# Migrations and scripts only: the database owner.
MIGRATE_DATABASE_URL=postgres://postgres:...@host:5432/postgres
# 32 random bytes, base64. Seals measurement keys and two-step secrets. Rotating it needs a re-seal.
SEAL_KEY=
# Vercel Cron sends it as a bearer token to /api/cron/*.
CRON_SECRET=
# The console's public address, for links in e-mail and the developer page.
APP_URL=https://gauge.antarax.ai
# AntaraX email (antarax-api docs/15): with both set to real values, every e-mail goes through the service as
# Gauge <gauge@mail.antarax.ai>, replies to support@go.antarax.ai, and Resend below is not used. Either one empty or a
# placeholder keeps Resend. Staging first: https://email-staging.antarax.ai (delivers only to the team's addresses).
ANTARAX_EMAIL_URL=
# Gauge's service key from the AntaraX email service, ax_svc_gauge_ and 32 letters and digits. A secret.
AX_SVC_KEY=ax_svc_gauge_…
# Resend, until the switch above is on: sign-in links and alerts. Needed in production (sign-in is by e-mailed link). In development, without it,
# sign-in links print in the server's terminal and alerts stay in the outbox table.
RESEND_API_KEY=
MAIL_FROM=AXLE · Outcomes <outcomes@antarax.ai>
# antarax.ai only sends; replies go to support (brand kit 13 §2). This is the default.
MAIL_REPLY_TO=support@go.antarax.ai
# Who gets "a link stopped answering" e-mail, comma separated.
ALERT_TO=
# Tests only: lets a production build accept http://localhost links. Never set it in a deployment.
# ALLOW_LOCAL_HTTP_LINKS=1
# Tests only: sign-in e-mails are written to this file instead of sent. Never set it in a deployment.
# MAIL_CAPTURE_FILE=test-results/mail.jsonl
