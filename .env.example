# The console's connection: a login role that is a member of outcomes_app (never the owner).
DATABASE_URL=postgres://outcomes_web:...@host:5432/postgres
# Migrations and scripts only: the database owner.
MIGRATE_DATABASE_URL=postgres://postgres:...@host:5432/postgres
# 32 random bytes, base64. Seals measurement keys and two-step secrets. Rotating it needs a re-seal.
SEAL_KEY=
# Vercel Cron sends it as a bearer token to /api/cron/*.
CRON_SECRET=
# The console's public address, for links in e-mail and the developer page.
APP_URL=https://outcomes.example
# Optional: send e-mail through Resend. Without it, messages stay in the outbox table.
RESEND_API_KEY=
MAIL_FROM=Outcomes <outcomes@reka.example>
# Who gets "a link stopped answering" e-mail, comma separated.
ALERT_TO=
# Tests only: lets a production build accept http://localhost links. Never set it in a deployment.
# ALLOW_LOCAL_HTTP_LINKS=1
