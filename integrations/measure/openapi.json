    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "This document",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1",
            "content": {
              "application/json": {}
            }
          },
          "401": {
            "description": "Not signed with this solution's measurement key, or more than five minutes off: invalid_signature.",
            "content": {
